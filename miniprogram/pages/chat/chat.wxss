.chat-shell { height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; }
.chat-messages { flex: 1; height: 0; min-height: 0; }
.chat-content { padding: 28rpx 28rpx 42rpx; }
.chat-empty { padding: 30rpx; line-height: 1.65; font-size: 30rpx; }
.mock-note { color: #7b8772; font-size: 23rpx; line-height: 1.5; padding: 10rpx 2rpx 22rpx; }
.message { margin: 22rpx 0 36rpx; line-height: 1.7; font-size: 30rpx; overflow-wrap: anywhere; }
.message-user { margin-left: auto; width: fit-content; max-width: 82%; box-sizing: border-box; padding: 20rpx 26rpx; background: #dce8d6; border-radius: 24rpx 24rpx 6rpx 24rpx; }
.message-assistant { padding: 4rpx 4rpx 16rpx; }
.message-text { white-space: pre-wrap; }
.message-status { font-size: 22rpx; color: #78836d; padding-top: 12rpx; }
.message-status.failed { color: #9b4a36; }
.chat-dish { width: 100%; text-align: left; padding: 22rpx 24rpx; margin-top: 20rpx; border: 1rpx solid #cfd9c7; border-radius: 16rpx; white-space: normal; line-height: 1.5; color: #315d43; font-size: 26rpx; background: #f9faf3; }
.chat-dish-name { font-weight: 600; font-size: 30rpx; }
.chat-dish-link { font-size: 24rpx; margin-top: 10rpx; }
.chat-communication { padding: 24rpx; margin-top: 22rpx; background: #e4ebd9; }
.communication-label { color: #6b7d62; font-size: 23rpx; }
.communication-title { font-size: 26rpx; margin-top: 8rpx; }
.communication-chinese { font-size: 36rpx; line-height: 1.6; margin-top: 18rpx; white-space: pre-wrap; }
.communication-paired { border-top: 1rpx solid #cbd4bf; padding-top: 16rpx; margin-top: 16rpx; font-size: 28rpx; white-space: pre-wrap; }
.chat-composer { flex-shrink: 0; padding: 12rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #dce1d4; background: #f2f0eb; }
.quick-questions { white-space: nowrap; width: 100%; }
.quick-strip { display: inline-flex; gap: 12rpx; padding: 8rpx 0 18rpx; }
.quick-question { min-height: 80rpx; padding: 18rpx 22rpx; flex-shrink: 0; border: 1rpx solid #cfd9c7; border-radius: 22rpx; color: #45694d; font-size: 25rpx; line-height: 1.6; background: #fafbf5; }
.compose-row { display: flex; align-items: flex-end; gap: 14rpx; }
.chat-input { flex: 1; width: 0; min-height: 52rpx; max-height: 220rpx; padding: 20rpx; background: #fffef8; border: 1rpx solid #cfd9c7; border-radius: 18rpx; font-size: 30rpx; line-height: 1.65; }
.chat-send { flex-shrink: 0; min-width: 118rpx; max-width: 30%; min-height: 90rpx; padding: 20rpx 22rpx; font-size: 27rpx; white-space: normal; overflow-wrap: anywhere; }
.composer-status { font-size: 22rpx; color: #7b8772; line-height: 1.45; margin-top: 12rpx; }

.new-reply-entry { flex-shrink: 0; padding: 8rpx 28rpx; background: #f2f0eb; }
.new-reply-button { min-height: 88rpx; padding: 18rpx 24rpx; background: #dce8d6; color: #315d43; border-radius: 22rpx; font-size: 27rpx; line-height: 1.6; white-space: normal; }
.draft-actions { display: flex; justify-content: flex-end; }
.draft-clear { min-height: 88rpx; padding: 16rpx 8rpx; font-size: 24rpx; line-height: 1.5; white-space: normal; }
.draft-save-error, .reading-save-error { font-size: 24rpx; line-height: 1.5; }
.reading-save-error { flex-shrink: 0; margin: 0 24rpx 12rpx; }
.reply-retry, .reply-continue { min-height: 88rpx; margin: 14rpx 0 0; padding: 18rpx 22rpx; max-width: 100%; width: fit-content; white-space: normal; overflow-wrap: anywhere; line-height: 1.6; text-align: left; }
.message-status.retrying { color: #45694d; }
.favorite-card { min-height: 88rpx; margin: 18rpx 0 0; padding: 18rpx 22rpx; width: fit-content; max-width: 100%; white-space: normal; overflow-wrap: anywhere; line-height: 1.6; text-align: left; }
.favorite-saved, .favorite-error { margin-top: 18rpx; font-size: 25rpx; line-height: 1.6; }
.favorite-saved { color: #315d43; }
.favorite-error { color: #8a452d; }
