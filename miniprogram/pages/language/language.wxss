.language-page { padding-top: 36rpx; }
.language-symbol { margin: 0 0 38rpx 16rpx; width: 92rpx; height: 86rpx; line-height: 86rpx; border-radius: 14rpx; position: relative; background: #dbe7d4; color: #315d43; text-align: center; font-size: 52rpx; transform: rotate(-7deg); box-shadow: 0 6rpx #b8c9a8, 0 10rpx 16rpx #314c3320; }
.language-symbol text { position: absolute; left: 60rpx; top: 30rpx; display: block; width: 60rpx; height: 65rpx; line-height: 65rpx; border-radius: 10rpx; background: #fffdf1; border: 1rpx solid #d9dbcb; box-shadow: 0 4rpx #bdc6ad; font-size: 45rpx; font-family: Georgia, serif; transform: rotate(13deg); }
.eyebrow { color: #6f8067; font-size: 25rpx; margin: 0 0 12rpx; }
.language-list { margin-top: 34rpx; padding: 0 30rpx; }
.language-option { display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; padding: 22rpx 4rpx; border-radius: 0; border-bottom: 1rpx solid #e2e7da; font-size: 31rpx; text-align: left; }
.language-option:last-child { border-bottom: 0; }
.language-option.active { font-weight: 600; }
.selected-mark, .unselected-mark { width: 42rpx; height: 42rpx; line-height: 40rpx; border-radius: 50%; font-size: 26rpx; text-align: center; }
.selected-mark { color: #fff; background: #315d43; }
.unselected-mark { border: 2rpx solid #ced8c3; background: #f9fbf2; }
