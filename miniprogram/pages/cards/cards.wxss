.cards-page { display: flex; flex-direction: column; overflow: hidden; }
.library-header { flex-shrink: 0; padding: 12rpx 36rpx 0; background: #f2f0eb; z-index: 2; }
.library-header .brand-row { margin-bottom: 8rpx; }
.library-header .page-heading { margin: 8rpx 0 14rpx; font-size: 40rpx; }
.library-intro { font-size: 25rpx; }
.category-tabs { display: flex; gap: 8rpx; margin-top: 26rpx; align-items: stretch; }
.category-tab { min-width: 0; flex: 1; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8rpx; padding: 14rpx 8rpx; min-height: 88rpx; border-radius: 20rpx; font-size: 24rpx; line-height: 1.3; color: #61735b; }
.category-tab.selected { background: #dfe6d6; color: #294f35; box-shadow: inset 0 2rpx #edf2e7, 0 3rpx #c8d2be; font-weight: 600; }
.category-count { font-size: 22rpx; opacity: .75; }
.library-toolbar { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; }
.library-count { color: #7b8772; font-size: 24rpx; }
.collapse-button { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.collapse-arrow { width: 17rpx; height: 17rpx; border-left: 3rpx solid #436044; border-top: 3rpx solid #436044; transform: translateY(5rpx) rotate(45deg); }
.library-scroll { flex: 1; min-height: 0; height: 0; width: 100%; }
.card-stage { position: relative; margin: 0 36rpx; }
.communication-card { position: absolute; left: 0; right: 0; top: 12rpx; height: 370rpx; padding: 24rpx 30rpx 46rpx; border: 1rpx solid #c3ceba; border-radius: 24rpx; background: #e5ebd9; box-shadow: inset 0 2rpx 0 #ffffffb8, 0 3rpx 0 #cbd5c1, 0 6rpx 0 #c0cbb7, 0 13rpx 22rpx #2f493018; transform-origin: center top; overflow: hidden; }
.animate .communication-card { transition: transform 380ms cubic-bezier(.2,.7,.2,1), opacity 300ms ease; }
.tone-blue { background: #e2e9e9; border-color: #c3cfcf; box-shadow: inset 0 2rpx #ffffffb8, 0 3rpx #d0dada, 0 6rpx #c0cbcb, 0 13rpx 22rpx #2f493018; }
.tone-orange { background: #eee4d4; border-color: #d6c9b8; box-shadow: inset 0 2rpx #ffffffb8, 0 3rpx #e0d5c4, 0 6rpx #d0c4b2, 0 13rpx 22rpx #2f493018; }
.card-category { display: flex; align-items: center; gap: 10rpx; color: #61735b; font-size: 22rpx; padding-right: 24rpx; }
.category-dot { width: 10rpx; height: 10rpx; flex-shrink: 0; border-radius: 50%; background: #6f8760; }
.communication-title { font-size: 32rpx; font-weight: 600; line-height: 1.3; margin-top: 14rpx; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow-wrap: anywhere; }
.communication-source { color: #35533a; font-size: 29rpx; line-height: 1.43; margin-top: 14rpx; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow-wrap: anywhere; white-space: pre-wrap; }
.communication-chinese { color: #78816e; font-size: 23rpx; line-height: 1.4; margin-top: 14rpx; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1; }
.card-footer { position: absolute; bottom: 16rpx; left: 30rpx; right: 30rpx; color: #86917d; font-size: 20rpx; display: flex; justify-content: space-between; align-items: center; }
.card-paper-mark { width: 32rpx; height: 9rpx; border-top: 1rpx solid #a5b49a; border-bottom: 1rpx solid #a5b49a; opacity: .6; }
.gesture-hint { margin: 12rpx 36rpx 24rpx; text-align: center; color: #7b8772; font-size: 24rpx; line-height: 1.6; }
.library-scroll .empty { margin: 20rpx 36rpx; }
.scroll-bottom { height: 32rpx; }
.card-error { display: flex; align-items: center; gap: 12rpx; padding: 18rpx; margin-bottom: 14rpx; background: #f0e4d3; color: #755236; border-radius: 16rpx; font-size: 24rpx; }
.card-error text { flex: 1; }
.card-error button { flex-shrink: 0; min-height: 88rpx; padding: 12rpx; display: flex; align-items: center; }
.reorder-row { display: flex; align-items: center; gap: 12rpx; min-height: 88rpx; color: #61735b; font-size: 23rpx; line-height: 1.4; padding-bottom: 12rpx; }
.reorder-row text { flex: 1; min-width: 0; }
.cancel-drag { flex-shrink: 0; min-width: 88rpx; min-height: 88rpx; padding: 12rpx; color: #315d43; }
.card-drop-slot { position: absolute; top: 12rpx; left: 0; right: 0; height: 370rpx; border: 3rpx dashed #7a9570; border-radius: 24rpx; background: #dce6d880; color: #53714e; padding: 22rpx; font-size: 24rpx; }
.is-dragging .communication-card { transition: transform 150ms ease; }
.is-dragging .lifted-card { transition: none; opacity: .94; box-shadow: inset 0 2rpx #ffffffb8, 0 5rpx #cbd5c1, 0 18rpx 36rpx #294b3640; }
