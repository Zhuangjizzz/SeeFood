<view class="cards-page" style="height:{{viewportHeight}}px;" wx:if="{{!needsLanguage}}">
  <view class="library-header">
    <view class="brand-row"><text class="section-title">{{copy.cards}}</text><button class="language-link" bindtap="openLanguage" aria-label="{{copy.language}}" hover-class="press"><image class="small-icon" src="/assets/globe.png" aria-hidden="true" /><text>{{languageName}}</text></button></view>
    <view class="page-heading">{{copy.cardsTitle}}</view>
    <view class="body-copy library-intro">{{copy.cardsBody}}</view>
    <view class="category-tabs" role="tablist">
      <button wx:for="{{categories}}" wx:key="id" class="category-tab {{category === item.id ? 'selected' : ''}}" data-category="{{item.id}}" bindtap="selectCategory" aria-role="tab" aria-selected="{{category === item.id}}"><text>{{item.label}}</text><text class="category-count">{{item.count}}</text></button>
    </view>
    <view class="library-toolbar"><text class="library-count">{{cardCount}} {{cardCopy.savedCards}}</text><button wx:if="{{expanded && cardCount}}" class="collapse-button" catchtap="collapseCards" aria-label="{{cardCopy.collapse}}"><view class="collapse-arrow"></view></button></view>
    <view wx:if="{{expanded && cardCount > 1}}" class="reorder-row" role="status"><text wx:if="{{dragging}}">{{cardCopy.dragHint}} · {{cardCopy.dropPosition}} {{dropPosition}} / {{cardCount}}</text><text wx:elif="{{reorderStatus}}">{{reorderStatus}}</text><text wx:elif="{{showSortHint}}">{{cardCopy.sortHint}}</text><button wx:if="{{dragging}}" class="cancel-drag" catchtap="cancelCardTouch">{{cardCopy.cancelDrag}}</button></view>
    <view class="card-error" wx:if="{{cardError}}" role="alert"><text>{{cardError}}</text><button bindtap="retryCards">{{cardCopy.retry}}</button></view>
  </view>
  <scroll-view class="library-scroll" scroll-y="{{scrollEnabled}}" scroll-top="{{scrollTop}}" bindscroll="onLibraryScroll" capture-catch:touchmove="{{dragging ? 'onCardTouchMove' : ''}}" show-scrollbar="{{false}}">
    <view wx:if="{{!cardCount && !cardError}}" class="empty paper"><view class="empty-title">{{totalCount ? cardCopy.emptyCategory : cardCopy.emptyLibrary}}</view></view>
    <view class="card-stage {{animate ? 'animate' : ''}} {{dragging ? 'is-dragging' : ''}}" style="height:{{stageHeight}}px;" wx:if="{{cardCount}}">
      <view wx:if="{{dragging}}" class="card-drop-slot" style="{{dropPlacement}}" aria-hidden="true"><text>{{cardCopy.dropPosition}} {{dropPosition}}</text></view>
      <view wx:for="{{cards}}" wx:key="id" class="communication-card tone-{{item.color}} {{item.lifted ? 'lifted-card' : ''}}" style="{{item.placement}}" data-id="{{item.id}}" bindtouchstart="onCardTouchStart" bindtouchmove="onCardTouchMove" bindtouchend="onCardTouchEnd" bindtouchcancel="cancelCardTouch" bindtap="showCard" aria-role="button" aria-label="{{item.title}}">
        <button wx:if="{{expanded && !dragging}}" class="card-menu-button" data-id="{{item.id}}" catchtouchstart="onMenuTouchStart" catchtouchmove="ignoreMenuEvent" catchtouchend="ignoreMenuEvent" catchtouchcancel="ignoreMenuEvent" catchtap="openCardMenu" aria-label="{{cardCopy.manageCard}}"><text aria-hidden="true">···</text></button>
        <view class="card-category"><view class="category-dot"></view><text>{{item.categoryLabel}}</text></view>
        <view class="communication-title">{{item.title}}</view>
        <view class="communication-source">{{item.sourceText}}</view>
        <view class="communication-chinese" wx:if="{{item.showChinese}}">{{item.textZh}}</view>
        <view class="card-footer"><text>SeeFood</text><view class="card-paper-mark"></view></view>
      </view>
    </view>
    <view wx:if="{{showExpandHint}}" class="gesture-hint">{{cardCopy.expandHint}}</view>
    <view wx:elif="{{cardCount && !expanded}}" class="gesture-hint">{{cardCopy.tapHint}}</view>
    <view class="scroll-bottom"></view>
  </scroll-view>
  <view wx:if="{{menuCard}}" class="card-menu-overlay" catchtouchmove="ignoreMenuEvent" catchtap="closeCardMenu">
    <view class="card-menu" catchtap="ignoreMenuEvent" role="dialog" aria-modal="true" aria-label="{{cardCopy.manageCard}}">
      <view class="card-menu-heading">{{cardCopy.manageCard}}</view>
      <view class="card-menu-title">{{menuCard.title}}</view>
      <view class="card-menu-explanation">{{cardCopy.deleteExplanation}}</view>
      <view wx:if="{{deletionError}}" class="card-menu-error" role="alert">{{deletionError}}</view>
      <button class="card-menu-delete" catchtap="deleteMenuCard">{{deletionError ? cardCopy.retryDelete : cardCopy.deleteCard}}</button>
      <button class="card-menu-cancel" catchtap="closeCardMenu">{{cardCopy.cancel}}</button>
    </view>
  </view>
</view>
