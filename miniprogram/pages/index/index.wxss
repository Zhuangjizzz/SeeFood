.welcome-panel { position: relative; min-height: 296rpx; border-radius: 26rpx; background: #e3eadc; box-shadow: inset 0 2rpx #ffffffcc, 0 4rpx #d2dbc8; margin-bottom: 24rpx; overflow: hidden; }
.welcome-copy { padding: 30rpx 28rpx 142rpx; position: relative; z-index: 1; }
.welcome-title { display: block; max-width: 600rpx; font-size: 43rpx; font-weight: 550; line-height: 1.18; letter-spacing: -1rpx; }
.welcome-body { display: block; font-size: 25rpx; line-height: 1.45; color: #5b7452; margin-top: 14rpx; max-width: 610rpx; }
.welcome-art { position: absolute; bottom: -8rpx; left: 65rpx; width: 540rpx; height: 150rpx; }
.welcome-note { background: #fffefa; border-radius: 18rpx; padding: 12rpx 20rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx #e0e3d8; display: flex; align-items: center; gap: 14rpx; }
.invite-copy { font-size: 24rpx; line-height: 1.45; color: #64765e; flex: 1; min-width: 0; }
.invite-actions { display: flex; gap: 12rpx; align-items: center; }
.invite-link { max-width: 150rpx; text-align: left; line-height: 1.35; min-height: 76rpx; }
.invite-skip { max-width: 104rpx; color: #7b8870; min-height: 76rpx; }
.mode-switch { display: flex; padding: 6rpx; background: #e4e8dd; border-radius: 100rpx; box-shadow: inset 0 2rpx 4rpx #50664514; }
.mode { flex: 1; min-width: 0; min-height: 80rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.mode.selected { background: #fffefa; color: #315d43; box-shadow: 0 4rpx #c7d0bf, 0 8rpx 14rpx #29453210; }
.input-hint { color: #6b7d62; font-size: 23rpx; line-height: 1.45; margin: 18rpx 4rpx 22rpx; }
.capture-actions { display: flex; gap: 18rpx; }
.capture-button { flex: 1; min-width: 0; min-height: 100rpx; padding: 18rpx 15rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 26rpx; line-height: 1.35; }
.capture-button text { min-width: 0; }
.primary { background: #315d43; color: #fffdf2; box-shadow: inset 0 2rpx #ffffff22, 0 5rpx #194a2f, 0 10rpx 16rpx #284d3510; }
.secondary { background: #fffefa; color: #315d43; border: 1rpx solid #b7c5ae; box-shadow: 0 4rpx #cbd4bf; }
.action-icon { width: 37rpx; height: 37rpx; flex-shrink: 0; }
.recent-section { margin-top: 32rpx; }
.chevron { font-size: 34rpx; margin-left: 12rpx; }

.recent-record { width: 100%; padding: 18rpx; margin: 12rpx 0; display: flex; align-items: center; gap: 18rpx; text-align: left; border-radius: 22rpx; }
.recent-image { width: 108rpx; height: 132rpx; border-radius: 12rpx; flex-shrink: 0; background: #e4e8dd; }
.missing-thumbnail { display: flex; align-items: center; justify-content: center; font-size: 48rpx; color: #78896c; }
.recent-body { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.recent-title { font-size: 27rpx; font-weight: 600; line-height: 1.4; }
.recent-meta { color: #7b8772; font-size: 22rpx; margin: 4rpx 0; }
.recent-progress { font-size: 23rpx; color: #715c3c; }
.recent-save { font-size: 22rpx; color: #66805d; }
.recent-chevron { font-size: 38rpx; color: #829277; }
