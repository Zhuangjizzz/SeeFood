.result-page { padding-bottom: calc(172rpx + env(safe-area-inset-bottom)); }
.result-chat-entry { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: #f2f0eb; border-top: 1rpx solid #dce1d4; }
.result-chat-entry button { width: 100%; min-height: 88rpx; white-space: normal; overflow-wrap: anywhere; }
.record-heading { font-size: 36rpx; font-weight: 600; margin-top: 16rpx; overflow-wrap: anywhere; }
.record-meta { font-size: 23rpx; color: #7b8772; margin: 8rpx 0 22rpx; }
.record-status { padding: 18rpx 24rpx; }
.status-row { display: flex; justify-content: space-between; gap: 22rpx; align-items: baseline; margin: 6rpx 0; font-size: 25rpx; }
.status-label { color: #71816c; flex-shrink: 0; max-width: 42%; }
.processing-state, .local-save-state { text-align: right; overflow-wrap: anywhere; }
.processing-state { color: #755c37; }
.local-save-state { color: #45694d; }
.image-selector { margin: 24rpx 0 10rpx; width: 100%; white-space: nowrap; }
.thumbnail-strip { display: inline-flex; gap: 14rpx; padding: 4rpx 6rpx 12rpx; }
.image-selector-button { width: 106rpx; height: 110rpx; flex-shrink: 0; position: relative; border-radius: 14rpx; border: 3rpx solid transparent; padding: 4rpx; }
.image-selector-button.selected-image { border-color: #315d43; background: #e4e8dd; }
.selector-thumbnail { width: 92rpx; height: 96rpx; border-radius: 9rpx; background: #e4e8dd; }
.missing-thumbnail { display: flex; align-items: center; justify-content: center; color: #829277; }
.selector-number { position: absolute; left: 4rpx; bottom: 4rpx; padding: 0 10rpx; border-radius: 0 8rpx 0 8rpx; background: #315d43; color: #fffefa; font-size: 22rpx; }
.original-label { color: #6b7d62; font-size: 24rpx; margin: 8rpx 0 12rpx; }
.original-button { width: 100%; height: 350rpx; padding: 12rpx; border-radius: 18rpx; }
.result-original { width: 100%; height: 326rpx; }
.add-photos { margin: 18rpx 0; width: 100%; min-height: 88rpx; border: 1rpx solid #819477; border-radius: 16rpx; color: #315d43; white-space: normal; }
.append-input { padding: 24rpx; margin: 18rpx 0; }
.append-target { font-size: 25rpx; overflow-wrap: anywhere; }
.append-mode, .append-sources { display: flex; gap: 16rpx; margin-top: 20rpx; }
.append-mode button, .append-sources button { flex: 1; min-width: 0; min-height: 88rpx; padding: 16rpx; font-size: 27rpx; white-space: normal; overflow-wrap: anywhere; border-radius: 14rpx; background: #e4e8dd; }
.append-mode .active { background: #315d43; color: #fffefa; }
.append-hint { font-size: 24rpx; line-height: 1.5; color: #6b7d62; margin-top: 16rpx; }
.image-progress-list { margin-top: 22rpx; padding: 4rpx 24rpx; }
.image-progress { padding: 18rpx 0; border-bottom: 1rpx solid #e2e5db; }
.image-progress:last-child { border-bottom: 0; }
.image-progress-name { font-size: 25rpx; font-weight: 600; }
.image-progress-states { display: flex; flex-wrap: wrap; gap: 6rpx 22rpx; font-size: 23rpx; color: #755c37; margin-top: 6rpx; }
.image-local-state { color: #6b7d62; }
.image-stage-state { color: #536b4c; font-size: 23rpx; line-height: 1.5; margin-top: 8rpx; overflow-wrap: anywhere; }
.image-progress .image-local-state { font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.retry-image-upload { min-height: 88rpx; padding: 18rpx 8rpx; white-space: normal; overflow-wrap: anywhere; text-align: left; }
.pending-explanation { font-size: 24rpx; color: #6b7d62; line-height: 1.5; margin: 20rpx 6rpx; }
.result-empty { margin: 24rpx 0 0; padding: 28rpx 22rpx; }
.retry-upload { width: 100%; min-height: 88rpx; margin: 20rpx 0; white-space: normal; overflow-wrap: anywhere; }
.cards-progress { color: #315d43; margin: 24rpx 6rpx 12rpx; font-size: 26rpx; }
.dish-section-title { font-size: 30rpx; font-weight: 600; margin-top: 28rpx; }
.mock-notice { color: #7c705b; font-size: 22rpx; line-height: 1.5; margin: 12rpx 0 20rpx; }
.dish-card { width: 100%; padding: 28rpx; margin: 18rpx 0; text-align: left; white-space: normal; line-height: 1.55; border-radius: 18rpx; }
.dish-name { font-size: 33rpx; color: #243d2c; font-weight: 600; overflow-wrap: anywhere; }
.dish-localized-name { color: #586d51; font-size: 27rpx; margin-top: 4rpx; overflow-wrap: anywhere; }
.dish-price { color: #755c37; font-size: 27rpx; margin-top: 12rpx; }
.dish-price-raw { color: #7b8772; font-size: 22rpx; margin-top: 4rpx; }
.dish-summary { color: #435c40; font-size: 26rpx; line-height: 1.6; margin-top: 14rpx; overflow-wrap: anywhere; }

.image-variant-controls { display: flex; gap: 14rpx; margin-top: 14rpx; }
.variant-button { flex: 1; min-height: 80rpx; padding: 12rpx 20rpx; line-height: 1.45; font-size: 26rpx; border-radius: 16rpx; white-space: normal; overflow-wrap: anywhere; background: #ebece4; color: #536b4c; }
.variant-button.variant-selected { background: #315d43; color: #fffefa; }
.variant-button[disabled] { background: #f0f0e9; color: #929c89; }
.translation-progress { font-size: 25rpx; line-height: 1.6; color: #536b4c; margin: 16rpx 6rpx 6rpx; overflow-wrap: anywhere; }
.image-save-states { font-size: 22rpx; line-height: 1.6; color: #6b7d62; margin: 8rpx 6rpx 16rpx; overflow-wrap: anywhere; }
