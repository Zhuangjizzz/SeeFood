<view class="page capture-page" wx:if="{{!needsLanguage}}">
  <view class="brand-row">
    <view class="brand"><text class="brand-seal">sf</text><text>SeeFood</text></view>
    <button class="language-link" bindtap="openLanguage" aria-label="{{copy.language}}" hover-class="press">
      <image class="small-icon" src="/assets/globe.png" aria-hidden="true" />
      <text>{{languageName}}</text>
    </button>
  </view>
  <view class="notice" wx:if="{{errorMessage}}" role="alert">{{errorMessage}}</view>
  <view class="welcome-panel">
    <view class="welcome-copy">
      <text class="welcome-title">{{copy.welcome}}</text>
      <text class="welcome-body">{{copy.welcomeBody}}</text>
    </view>
    <image class="welcome-art" src="/assets/table-scene.png" mode="aspectFit" aria-hidden="true" />
  </view>
  <view class="welcome-note" wx:if="{{showPreferenceInvite}}">
    <text class="invite-copy">{{copy.preferenceBody}}</text>
    <view class="invite-actions">
      <button class="text-button invite-link" bindtap="openPreferences" hover-class="press">{{copy.setPreferences}}</button>
      <button class="text-button invite-skip" bindtap="skipPreferenceInvite" hover-class="press">{{copy.skip}}</button>
    </view>
  </view>
  <view class="capture-input">
    <view class="mode-switch">
      <button class="mode {{inputMode === 'menu' ? 'selected' : ''}}" data-mode="menu" bindtap="chooseMode" disabled="{{choosing}}" aria-pressed="{{inputMode === 'menu'}}" hover-class="press">{{copy.menu}}</button>
      <button class="mode {{inputMode === 'dish' ? 'selected' : ''}}" data-mode="dish" bindtap="chooseMode" disabled="{{choosing}}" aria-pressed="{{inputMode === 'dish'}}" hover-class="press">{{copy.dish}}</button>
    </view>
    <view class="input-hint">{{inputMode === 'dish' ? captureCopy.dishHint : copy.inputHint}}</view>
    <view class="notice" wx:if="{{inputError}}" role="alert">{{inputError}}</view>
    <view class="capture-actions">
      <button class="capture-button primary" bindtap="takePhoto" disabled="{{choosing}}" hover-class="press">
        <image class="action-icon" src="/assets/camera-white.png" aria-hidden="true" /><text>{{copy.takePhoto}}</text>
      </button>
      <button class="capture-button secondary" bindtap="importPhoto" disabled="{{choosing}}" hover-class="press">
        <image class="action-icon" src="/assets/album.png" aria-hidden="true" /><text>{{copy.importPhoto}}</text>
      </button>
    </view>
  </view>
  <view class="recent-section">
    <view class="section-heading"><text class="section-title">{{copy.recent}}</text><button class="text-button" bindtap="openHistory" hover-class="press">{{copy.viewAll}} <text class="chevron">›</text></button></view>
    <view class="notice" wx:if="{{historyError}}" role="alert">
      <view>{{historyError}}</view>
      <button class="text-button" bindtap="retryHistory">{{recordCopy.retryRead}}</button>
    </view>
    <button wx:for="{{recentRecords}}" wx:key="id" class="recent-record paper" data-id="{{item.id}}" bindtap="openRecord" hover-class="press">
      <image wx:if="{{item.thumbnail}}" class="recent-image" src="{{item.thumbnail}}" mode="aspectFill" />
      <view wx:else class="recent-image missing-thumbnail">▤</view>
      <view class="recent-body">
        <view class="recent-title">{{item.title}}</view>
        <view class="recent-meta">{{item.createdAtLabel}} · {{item.imageCount}} {{recordCopy.photos}}</view>
        <view class="recent-progress">{{item.processingLabel}}</view>
        <view class="recent-save">{{item.saveLabel}}</view>
      </view>
      <text class="recent-chevron">›</text>
    </button>
    <view class="empty paper" wx:if="{{historyReadable && !recentRecords.length}}">
      <view class="empty-title">{{copy.emptyRecent}}</view>
      <view class="empty-copy">{{copy.emptyRecentBody}}</view>
    </view>
  </view>
</view>
