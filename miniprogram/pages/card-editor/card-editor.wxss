.card-editor-page{padding:24rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));color:#284435}.editor-back{margin:0 0 18rpx;padding:8rpx 0;min-height:72rpx;background:transparent;text-align:left;font-size:27rpx;color:#42654d;line-height:1.5}.editor-heading{font-size:46rpx;font-weight:700;line-height:1.25;margin:16rpx 0 24rpx}.draft-status{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:23rpx;line-height:1.5;color:#637661;margin-bottom:22rpx}.draft-status button{margin:0;flex-shrink:0;font-size:23rpx;padding:14rpx;background:#f6e9db;color:#7f402e;line-height:1.4;max-width:230rpx}.save-error{color:#983f30}.editor-field,.draft-recovery{padding:30rpx;margin-bottom:24rpx;border:1rpx solid #d4ddcd;border-radius:20rpx;background:#fafbf5;box-shadow:0 6rpx 0 #e1e6d9,0 12rpx 20rpx rgba(40,68,53,.05)}.field-title{display:block;font-size:29rpx;font-weight:650;line-height:1.5;margin-bottom:10rpx}.input-language,.field-help,.mock-note{font-size:22rpx;line-height:1.5;color:#6c7e69;margin-bottom:18rpx}.source-input,.chinese-input{width:100%;min-height:150rpx;font-size:32rpx;line-height:1.65;color:#294735;box-sizing:border-box}.chinese-input{font-size:36rpx}.generate-chinese,.continue-translation{width:100%;min-height:84rpx;background:#dfebd6;color:#345b3e;font-size:28rpx;line-height:1.4;padding:22rpx;margin-bottom:24rpx;border:1rpx solid #b4c7a8;border-radius:14rpx}.translation-status{font-size:24rpx;line-height:1.6;color:#6b6449;margin:0 0 18rpx}.title-input{height:76rpx;padding:0 18rpx;border:1rpx solid #cdd8c6;border-radius:12rpx;font-size:28rpx;background:#fffdf7;margin:12rpx 0 28rpx}.category-options,.color-options{display:flex;flex-wrap:wrap;gap:12rpx;margin:12rpx 0 28rpx}.color-options{margin-bottom:0}.option{margin:0;flex:1;min-width:170rpx;min-height:86rpx;padding:19rpx 14rpx;background:#f2f3ea;color:#536a50;line-height:1.5;font-size:25rpx;border:2rpx solid transparent;border-radius:12rpx}.option.selected{border-color:#50784a;background:#e3edda;color:#284e31}.color-option{display:flex;align-items:center;justify-content:center;gap:10rpx;flex-basis:25%}.color-dot{width:28rpx;height:28rpx;border-radius:50%;border:1rpx solid #99ad8e;flex-shrink:0}.tone-green{background:#dceacd}.tone-blue{background:#dde8ef}.tone-orange{background:#f1e0c5}.discard-draft{margin:16rpx 0;padding:22rpx;min-height:88rpx;font-size:27rpx;line-height:1.5;color:#6d6a58;background:transparent}.editor-save-bar{position:fixed;z-index:10;left:0;right:0;bottom:0;padding:22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));background:#f2f0eb;border-top:1rpx solid #d8dfcf}.primary-button{width:100%;margin:0;min-height:96rpx;padding:24rpx;background:#355f43;border-radius:16rpx;color:#fffdf4;font-size:30rpx;font-weight:650;line-height:1.5}.primary-button[disabled],.generate-chinese[disabled]{opacity:.5}.recovery-heading{font-size:32rpx;font-weight:650;line-height:1.5}.recovery-preview{font-size:28rpx;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere;margin:18rpx 0 28rpx}.mock-note{margin:22rpx 0 0}
