<view class="page result-page">
  <view wx:if="{{recordError}}" class="notice record-error" role="alert">
    <view>{{recordError}}</view>
    <button wx:if="{{canRetryRead}}" class="text-button" bindtap="retryRead">{{recordCopy.retryRead}}</button>
    <button wx:else class="text-button" bindtap="back">{{recordCopy.back}}</button>
  </view>
  <block wx:if="{{record}}">
    <view class="record-heading">{{title}}</view>
    <view class="record-meta">{{createdAtLabel}} · {{imageCount}} {{recordCopy.photos}}</view>
    <view class="record-status paper">
      <view class="status-row"><text class="status-label">{{recordCopy.uploadLabel}}</text><text class="processing-state">{{processingLabel}}</text></view>
      <view class="status-row"><text class="status-label">{{recordCopy.saveLabel}}</text><text class="local-save-state">{{saveLabel}}</text></view>
    </view>
    <scroll-view class="image-selector" scroll-x>
      <view class="thumbnail-strip">
        <button wx:for="{{record.images}}" wx:key="id" class="image-selector-button {{currentImageId === item.id ? 'selected-image' : ''}}" data-id="{{item.id}}" bindtap="selectImage" aria-label="{{recordCopy.photo}} {{index + 1}}" aria-pressed="{{currentImageId === item.id}}">
          <image wx:if="{{item.original.saveState === 'saved'}}" src="{{item.localOriginalPath}}" mode="aspectFill" class="selector-thumbnail" />
          <view wx:else class="selector-thumbnail missing-thumbnail">▤</view>
          <text class="selector-number">{{index + 1}}</text>
        </button>
      </view>
    </scroll-view>
    <view class="original-label">{{recordCopy.original}} · {{recordCopy.photo}} {{currentImage.order + 1}}</view>
    <button wx:if="{{currentImage.original.saveState === 'saved' && !uploadOriginalMissing}}" class="original-button paper" bindtap="viewOriginal" aria-label="{{recordCopy.original}} {{recordCopy.photo}} {{currentImage.order + 1}}">
      <image class="result-original" src="{{currentImage.localOriginalPath}}" mode="aspectFit" />
    </button>
    <view wx:else class="notice missing-original" role="alert">{{recordCopy.missingOriginal}}</view>
    <button class="add-photos" bindtap="addPhotos">{{captureCopy.addPhotos}}</button>
    <view wx:if="{{showAppendInput}}" class="append-input paper">
      <view class="append-target">{{captureCopy.appendRecord}} · {{title}}</view>
      <view class="append-mode">
        <button data-mode="menu" bindtap="chooseMode" class="{{inputMode === 'menu' ? 'active' : ''}}" aria-pressed="{{inputMode === 'menu'}}">{{copy.menu}}</button>
        <button data-mode="dish" bindtap="chooseMode" class="{{inputMode === 'dish' ? 'active' : ''}}" aria-pressed="{{inputMode === 'dish'}}">{{copy.dish}}</button>
      </view>
      <view wx:if="{{inputMode === 'dish'}}" class="append-hint">{{captureCopy.dishHint}}</view>
      <view wx:if="{{inputError || appendError}}" class="notice" role="alert">{{appendError || inputError}}</view>
      <view class="append-sources">
        <button bindtap="takePhoto" disabled="{{choosing}}">{{copy.takePhoto}}</button>
        <button bindtap="importPhoto" disabled="{{choosing}}">{{copy.importPhoto}}</button>
      </view>
      <button class="text-button" bindtap="closeAppendInput">{{captureCopy.cancel}}</button>
    </view>
    <view class="image-progress-list paper">
      <view wx:for="{{imageStates}}" wx:key="id" class="image-progress">
        <view class="image-progress-name">{{recordCopy.photo}} {{item.order + 1}} · {{item.kind === 'dish' ? copy.dish : copy.menu}}</view>
        <view class="image-progress-states"><text>{{item.processingLabel}}</text><text class="image-local-state">{{item.saveLabel}}</text></view>
      </view>
    </view>
    <view wx:if="{{uploadLocalFailure}}" class="notice upload-save-error" role="alert">{{uploadCopy.localFailure}}</view>
    <view wx:if="{{uploadInterrupted && originalsSaved && !uploadLocalFailure}}" class="notice upload-interrupted" role="status">{{uploadCopy.interruptedBody}}</view>
    <view wx:elif="{{uploadResuming}}" class="pending-explanation upload-explanation" role="status">{{uploadCopy.resumingBody}}</view>
    <view wx:elif="{{uploadState === 'pending' && originalsSaved}}" class="pending-explanation">{{recordCopy.pendingBody}}</view>
    <view wx:elif="{{uploadState === 'uploading'}}" class="pending-explanation upload-explanation" role="status">{{uploadCopy.uploadingBody}}</view>
    <view wx:elif="{{uploadState === 'uploaded' && !cardsJob && !cardsAcceptancePending}}" class="pending-explanation upload-explanation" role="status">{{uploadCopy.uploadedBody}}</view>
    <view wx:elif="{{uploadState === 'failed' && !uploadLocalFailure && !uploadOriginalMissing}}" class="notice upload-error" role="alert">{{uploadCopy.failedBody}}</view>
    <button wx:if="{{canRetryUpload}}" class="primary-button retry-upload" bindtap="retryUpload">{{uploadCopy.retryUpload}}</button>
    <view class="cards-progress" role="status">{{cardsStateLabel}}</view>
    <view wx:if="{{canLeave}}" class="pending-explanation accepted-explanation">{{dishCopy.accepted}}</view>
    <view wx:if="{{cardsSaveFailed}}" class="notice result-save-error" role="alert">
      <view>{{dishCopy.saveFailed}}</view><button class="text-button" bindtap="retryResultSave">{{dishCopy.retrySave}}</button>
    </view>
    <view wx:if="{{cardsReadFailed}}" class="notice result-read-error" role="alert">
      <view>{{dishCopy.readFailed}}</view><button class="text-button retry-progress" bindtap="retryProgress">{{recoveryCopy.checkAgain}}</button>
    </view>
    <view wx:if="{{dishCards.length}}" class="dish-section">
      <view class="dish-section-title">{{dishCopy.dishes}}</view>
      <view class="mock-notice">{{dishCopy.mock}}</view>
      <button wx:for="{{dishCards}}" wx:key="id" class="dish-card paper" data-id="{{item.id}}" bindtap="openDish">
        <view class="dish-name">{{item.displayName}}</view>
        <view wx:if="{{item.secondaryName}}" class="dish-localized-name">{{item.secondaryName}}</view>
        <view class="dish-price">{{item.priceLabel}}</view>
        <view wx:if="{{item.priceRaw}}" class="dish-price-raw">{{item.priceRaw}}</view>
        <view wx:if="{{item.summary}}" class="dish-summary">{{item.summary}}</view>
      </button>
    </view>
    <view wx:elif="{{cardsJob.state === 'succeeded'}}" class="empty paper result-empty no-dish-cards"><view class="empty-copy">{{dishCopy.noCards}}</view></view>
    <view wx:else class="empty paper result-empty"><view class="empty-copy">{{recordCopy.noDishes}}</view></view>
    <view class="result-chat-entry"><button class="primary-button" bindtap="openChat">{{chatCopy.entry}}</button></view>
  </block>
</view>
