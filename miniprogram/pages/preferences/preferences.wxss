.preferences-page { height: 100vh; display: flex; flex-direction: column; }
.preferences-scroll { flex: 1; min-height: 0; height: 0; }
.preferences-content { padding: 24rpx 36rpx 32rpx; }
.preferences-intro { margin: 0 0 30rpx; font-size: 26rpx; }
.preference-group { margin-bottom: 36rpx; }
.group-heading { display: flex; align-items: baseline; gap: 16rpx; font-weight: 600; font-size: 32rpx; line-height: 1.35; margin-bottom: 22rpx; }
.group-number { color: #8a997e; font-size: 22rpx; font-weight: 400; }
.preference-options { display: flex; flex-wrap: wrap; gap: 14rpx 12rpx; }
.preference-option { display: flex; align-items: center; gap: 10rpx; min-height: 90rpx; padding: 16rpx 22rpx; max-width: 100%; border: 1rpx solid #cbd5bf; background: #fffefa; color: #4c6946; text-align: left; font-size: 26rpx; line-height: 1.4; box-shadow: 0 3rpx #d9dfcf; overflow-wrap: anywhere; }
.preference-option.selected { background: #dce9d2; border-color: #62855a; color: #254b31; }
.option-mark { flex-shrink: 0; width: 28rpx; font-size: 28rpx; }
.group-hint { color: #6b7d63; font-size: 23rpx; line-height: 1.55; margin: 20rpx 0 24rpx; }
.notes-label { display: flex; align-items: baseline; gap: 14rpx; margin-bottom: 12rpx; font-size: 25rpx; }
.optional { color: #819075; font-size: 22rpx; }
.preference-notes { box-sizing: border-box; width: 100%; min-height: 150rpx; padding: 20rpx 22rpx; background: #fffefa; border: 1rpx solid #d1dac7; border-radius: 18rpx; color: #294b36; font-size: 28rpx; line-height: 1.55; }
.notes-placeholder { color: #87927c; font-size: 25rpx; }
.preference-footer { flex-shrink: 0; padding: 20rpx 36rpx calc(20rpx + env(safe-area-inset-bottom)); background: #f9f8f2; border-top: 1rpx solid #d9dfce; box-shadow: 0 -6rpx 16rpx #29453208; }
.save-preferences { min-height: 94rpx; padding: 20rpx; width: 100%; background: #315d43; color: #fffdf2; font-size: 28rpx; box-shadow: inset 0 2rpx #ffffff22, 0 4rpx #194a2f; }
.save-preferences[disabled] { opacity: .45; }
.skip-preferences { width: 100%; min-height: 80rpx; margin-top: 6rpx; }
.save-error { color: #755236; font-size: 24rpx; line-height: 1.5; margin-bottom: 18rpx; }
.read-retry { width: 100%; }
