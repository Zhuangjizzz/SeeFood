page {
  background: #f2f0eb;
  color: #294b36;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Kaku Gothic ProN', 'Malgun Gothic', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}
view, button, text { box-sizing: border-box; }
button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: 1.4;
  border-radius: 100rpx;
}
button::after { border: 0; }
.page { padding: 16rpx 36rpx 48rpx; }
.brand-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; gap: 16rpx; margin-bottom: 18rpx; }
.brand { display: flex; align-items: center; gap: 14rpx; font-weight: 650; font-size: 38rpx; letter-spacing: -1rpx; }
.brand-seal { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border-radius: 50%; background: #315d43; color: #fffdf2; font: 36rpx Georgia, serif; box-shadow: inset 0 2rpx 0 #66856b, 0 3rpx 0 #bdc8b3; }
.language-link { display: flex; align-items: center; justify-content: flex-end; min-height: 88rpx; padding-left: 12rpx; gap: 10rpx; color: #45694d; font-size: 25rpx; }
.small-icon { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.page-heading { font-size: 43rpx; line-height: 1.24; font-weight: 550; letter-spacing: -1rpx; margin: 20rpx 0 18rpx; }
.body-copy { font-size: 27rpx; line-height: 1.6; color: #64775e; }
.section-heading { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin-bottom: 10rpx; }
.section-title { min-width: 0; font-size: 32rpx; font-weight: 600; }
.text-button { color: #315d43; min-height: 88rpx; padding: 12rpx 2rpx; font-size: 25rpx; display: flex; align-items: center; justify-content: center; }
.paper { background: #fffefa; border-radius: 24rpx; box-shadow: inset 0 2rpx 0 #ffffff, 0 4rpx 0 #d8ddce, 0 10rpx 22rpx #243d2f0a; }
.empty { padding: 40rpx 26rpx; text-align: center; }
.empty-title { font-size: 31rpx; line-height: 1.4; color: #476344; margin-bottom: 12rpx; }
.empty-copy { color: #7b8772; font-size: 25rpx; line-height: 1.6; }
.notice { padding: 22rpx 26rpx; background: #f0e4d3; color: #755236; font-size: 26rpx; line-height: 1.6; border-radius: 18rpx; margin: 14rpx 0 24rpx; }
.press { transform: scale(.97); opacity: .88; }
